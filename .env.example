# Banco local SQLite (caminho relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"

# --- A partir da Fase 3 ---

# Keypair de devnet, em base58, que paga as taxas de mint.
# SERVER-ONLY: nunca prefixe com NEXT_PUBLIC_.
APP_KEYPAIR_SECRET=

# Chave gratuita da Helius (https://helius.dev) para a DAS API de devnet.
HELIUS_API_KEY=

# Endereço da Core Collection, gerado uma vez pelo script de setup.
COLLECTION_ADDRESS=

# Opcional: RPC customizado. Sem isso, usa o RPC público de devnet.
NEXT_PUBLIC_RPC_URL=
