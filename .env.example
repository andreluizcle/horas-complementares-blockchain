# Banco local SQLite (caminho relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"

# --- A partir da Fase 3 ---

# Keypair de devnet, em base58, que paga as taxas de mint.
# SERVER-ONLY: nunca prefixe com NEXT_PUBLIC_.
APP_KEYPAIR_SECRET=

# Chave gratuita da Helius (https://helius.dev) para a DAS API de devnet.
HELIUS_API_KEY=

# Endereço da Core Collection, gerado uma vez pelo script de setup.
COLLECTION_ADDRESS=

# Opcional: RPC usado pelo NAVEGADOR. Por ser NEXT_PUBLIC_, vai para o bundle
# do cliente — NUNCA coloque a URL da Helius aqui, ela contém a sua chave.
# Sem isso, o cliente usa o RPC público de devnet, que é o suficiente: o mint
# acontece no servidor, que usa a Helius por conta própria.
NEXT_PUBLIC_RPC_URL=
